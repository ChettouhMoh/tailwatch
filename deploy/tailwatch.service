[Unit]
Description=Tailwatch SSH login monitor
After=systemd-journald.service

[Service]
Type=exec
LoadCredential=tailwatch-channel:/etc/tailwatch/channel.json
ExecStartPre=/usr/bin/tailwatch -check -config /etc/tailwatch/config.json -channel %d/tailwatch-channel
ExecStart=/usr/bin/tailwatch -config /etc/tailwatch/config.json -channel %d/tailwatch-channel -state /var/lib/tailwatch/journal.json
DynamicUser=yes
SupplementaryGroups=systemd-journal
StateDirectory=tailwatch
StateDirectoryMode=0700
EnvironmentFile=-/etc/tailwatch/environment
Restart=on-failure
RestartSec=15s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
